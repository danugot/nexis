FROM python:3.11-slim

WORKDIR /app

# Install dependencies required for building some python packages if needed
RUN apt-get update && apt-get install -y gcc g++ libpq-dev && rm -rf /var/lib/apt/lists/*

COPY requirements-all.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy all root project directories needed to run the app
COPY python_services /app/python_services
COPY services/rag_api /app/services/rag_api

ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "services.rag_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
